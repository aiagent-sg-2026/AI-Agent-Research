{
  "version": "v5.1-contract-1",
  "taskId": "V51-P06-FORMAL-normalize-party",
  "rules": [
    {
      "id": "C1",
      "text": "input must be non-array object with non-empty string party"
    },
    {
      "id": "C2",
      "text": "credit accepts non-negative integer or digit-only string and returns integer"
    },
    {
      "id": "C3",
      "text": "enabled defaults true and otherwise must be boolean"
    },
    {
      "id": "C4",
      "text": "unknown fields are omitted"
    },
    {
      "id": "C5",
      "text": "malformed input returns null"
    }
  ],
  "returnSchema": {
    "anyOf": [
      {
        "type": "object",
        "required": [
          "party",
          "credit",
          "enabled"
        ],
        "properties": {
          "party": {
            "type": "string",
            "minLength": 1
          },
          "credit": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "null"
      }
    ]
  },
  "observationSchema": {
    "type": "object",
    "required": [],
    "properties": {},
    "additionalProperties": false
  },
  "errorVariants": []
}
