{
  "version": "v5.1-contract-1",
  "taskId": "V51-P05-FORMAL-codec-negotiation",
  "rules": [
    {
      "id": "C1",
      "text": "consider only peer-advertised codecs in local order c4 then c2"
    },
    {
      "id": "C2",
      "text": "c4 requires capability 'binary'; c2 requires none"
    },
    {
      "id": "C3",
      "text": "open failure of compatible codec falls through to next compatible advertised codec"
    },
    {
      "id": "C4",
      "text": "if opened channel.version differs from requested codec, close it and continue"
    },
    {
      "id": "C5",
      "text": "if none succeeds throw name NoCompatibleCodec with exact message 'No compatible codec'"
    }
  ],
  "returnSchema": {
    "type": "object",
    "required": [
      "version"
    ],
    "properties": {
      "version": {
        "type": "string",
        "enum": [
          "c4",
          "c2"
        ]
      }
    },
    "additionalProperties": false
  },
  "observationSchema": {
    "type": "object",
    "required": [
      "opened",
      "closed"
    ],
    "properties": {
      "opened": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "closed": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "errorVariants": [
    {
      "id": "none",
      "name": "NoCompatibleCodec",
      "message": "No compatible codec"
    }
  ]
}
