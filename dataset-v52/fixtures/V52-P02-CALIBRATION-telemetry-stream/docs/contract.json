{"version":"v5.2-contract-1","taskId":"V52-P02-CALIBRATION-telemetry-stream","rules":[{"id":"C1","text":"write accepts partial length-prefixed chunks and emits complete payloads in order"},{"id":"C2","text":"buffered bytes are bounded by highWaterMark and write reports backpressure"},{"id":"C3","text":"drain resumes delivery without reordering"},{"id":"C4","text":"abort rejects pending work and emits abort before close"},{"id":"C5","text":"close is idempotent and no post-close writes are accepted"},{"id":"C6","text":"frame and lifecycle events are ordered and trace entries are copied"}],"callableSurface":{"factory":"createTelemetryStream(onFrame,{highWaterMark,signal}) -> {write(chunk),drain(),abort(),close(),trace()}","ownership":"stream owns parser, queue, lifecycle and trace; sink owns received payloads","methods":["write(chunk:string)->boolean","drain()->void","abort()->void","close()->void","trace()->event[]"]},"stateModel":{"states":["open","backpressured","aborted","closed"],"transitions":["write -> open/backpressured","drain -> open","abort -> aborted","close -> closed"],"terminal":"aborted and closed reject later writes"},"eventOrdering":["chunk before frame","frame order follows input","abort before close","close once and after queued frames"],"abortErrorPrecedence":"abort wins over close for pending delivery and uses AbortError/Aborted","identityMutation":{"inputs":"write chunks are not mutated","frames":"payload strings are newly delivered","trace":"trace returns copied entries"},"traceSchema":{"type":"array","items":{"type":"object","required":["type"],"properties":{"type":{"type":"string","enum":["chunk","frame","pause","drain","abort","close"]},"size":{"type":"integer"},"value":{"type":"string"}},"additionalProperties":false}},"returnSchema":{"type":"boolean"},"observationSchema":{"type":"object","required":["frames","writes","accepted","trace","error"],"properties":{"frames":{"type":"array","items":{"type":"string"}},"writes":{"type":"integer"},"accepted":{"type":"array","items":{"type":"boolean"}},"trace":{"type":"array","items":{"type":"string"}},"error":{"type":["string","null"]}},"additionalProperties":false},"errorVariants":[{"id":"aborted","name":"AbortError","message":"Aborted"},{"id":"closed","name":"Error","message":"Closed"}]}
