{"version":"v5.2-contract-1","taskId":"V52-P02-FORMAL-audit-stream","rules":[{"id":"C1","text":"write accepts partial audit records framed as length:value;"},{"id":"C2","text":"queue size controls pause and write return value"},{"id":"C3","text":"resume drains queued records in order"},{"id":"C4","text":"cancel clears pending records and precedes shutdown"},{"id":"C5","text":"shutdown is one-shot and rejects later writes"},{"id":"C6","text":"trace preserves chunk, record and lifecycle ordering"}],"callableSurface":{"factory":"createAuditStream(onRecord,{highWaterMark,signal}) -> {write,drain,cancel,shutdown,trace}","ownership":"stream owns buffering, queue and lifecycle","methods":["write(chunk:string)->boolean","drain()->void","cancel()->void","shutdown()->void","trace()->event[]"]},"stateModel":{"states":["open","paused","cancelled","shutdown"],"transitions":["write -> open/paused","drain -> open","cancel -> cancelled","shutdown -> shutdown"]},"eventOrdering":["chunk before record","cancel before shutdown","shutdown once"],"abortErrorPrecedence":"cancel wins and reports AbortError/Aborted","identityMutation":{"inputs":"chunks are read only","records":"records are copied to sink","trace":"trace is copied"},"traceSchema":{"type":"array","items":{"type":"object","required":["type"],"properties":{"type":{"type":"string","enum":["chunk","record","pause","drain","cancel","shutdown"]},"size":{"type":"integer"},"value":{"type":"string"}},"additionalProperties":false}},"returnSchema":{"type":"boolean"},"observationSchema":{"type":"object","required":["records","writes","accepted","trace","error"],"properties":{"records":{"type":"array","items":{"type":"string"}},"writes":{"type":"integer"},"accepted":{"type":"array","items":{"type":"boolean"}},"trace":{"type":"array","items":{"type":"string"}},"error":{"type":["string","null"]}},"additionalProperties":false},"errorVariants":[{"id":"aborted","name":"AbortError","message":"Aborted"},{"id":"closed","name":"Error","message":"C