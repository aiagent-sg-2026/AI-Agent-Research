{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Quality Benchmark V2 registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "control", "tracks", "taskFamilies", "pins", "metrics", "promotion", "contamination", "frozenInputs"],
  "properties": {
    "version": {"const": "benchmark-v2"},
    "control": {"type": "string", "const": "CONTROL"},
    "tracks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/track"}},
    "taskFamilies": {"type": "array", "const": ["BUGFIX", "FEATURE", "REFACTOR", "DATA_WORKFLOW", "TOOL_USE", "SAFETY_BOUNDARY"]},
    "pins": {"type": "object", "required": ["model", "tools", "context", "harness"], "additionalProperties": false, "properties": {"model":{"type":"object","required":["id","provider","reasoning","cli"],"additionalProperties":false,"properties":{"id":{"type":"string"},"provider":{"type":"string"},"reasoning":{"type":"string"},"cli":{"type":"string"}}},"tools":{"type":"object","required":["policy","versions"],"additionalProperties":false,"properties":{"policy":{"type":"string"},"versions":{"type":"object"}}},"context":{"type":"object","required":["policy","tokenBudget"],"additionalProperties":false,"properties":{"policy":{"type":"string"},"tokenBudget":{"type":"integer","minimum":1}}},"harness":{"type":"object","required":["version","digest"],"additionalProperties":false,"properties":{"version":{"type":"string"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}},
    "metrics": {"type":"object","required":["outcome","trajectory","reliability","efficiency","safety","scoreWeights"],"additionalProperties":false,"properties":{"outcome":{"type":"array","minItems":1,"items":{"type":"string"}},"trajectory":{"type":"array","minItems":1,"items":{"type":"string"}},"reliability":{"type":"array","minItems":1,"items":{"type":"string"}},"efficiency":{"type":"array","minItems":1,"items":{"type":"string"}},"safety":{"type":"array","minItems":1,"items":{"type":"string"}},"scoreWeights":{"type":"object","const":{"outcome":50,"trajectory":20,"reliability":15,"efficiency":10,"safety":5}}}},
    "promotion": {"type":"object","required":["screeningTrials","confirmationTrials","minDeltaPoints","maxInvalidRate","criticalSafetyViolations","interval","bootstrapUnit"],"additionalProperties":false,"properties":{"screeningTrials":{"const":5},"confirmationTrials":{"const":20},"minDeltaPoints":{"const":5},"maxInvalidRate":{"const":0.02},"criticalSafetyViolations":{"const":0},"interval":{"const":"95%"},"bootstrapUnit":{"const":"task-block"}}},
    "contamination": {"type":"object","required":["forbidden","invalidatesCell"],"additionalProperties":false,"properties":{"forbidden":{"type":"array","minItems":1,"items":{"type":"string"}},"invalidatesCell":{"const":true}}},
    "frozenInputs": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{"id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
  },
  "$defs": {"track":{"type":"object","additionalProperties":false,"required":["id","factor","design","levels","isolation","trials"],"properties":{"id":{"type":"string","enum":["PROMPT","AGENTS","SKILLS","CONTEXT","HARNESS","COMBINED"]},"factor":{"type":"string"},"design":{"type":"object","additionalProperties":false,"required":["type","seed","randomization"],"properties":{"type":{"type":"string","enum":["one-factor","factorial"]},"seed":{"type":"integer"},"randomization":{"const":"paired-blocked"},"interactionHypothesis":{"type":"string"}}},"levels":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["id","changes","check"],"properties":{"id":{"type":"string"},"changes":{"type":"array","minItems":1,"items":{"type":"string"}},"check":{"type":"string"}}}},"isolation":{"type":"object","additionalProperties":false,"required":["changedFactorOnly","explicitCombinations"],"properties":{"changedFactorOnly":{"type":"boolean"},"explicitCombinations":{"type":"array","items":{"type":"string"}}}},"trials":{"type":"object","additionalProperties":false,"required":["screening","confirmation","freshWorkspace"],"properties":{"screening":{"const":5},"confirmation":{"const":20},"freshWorkspace":{"const":true}}}}}
}
}
